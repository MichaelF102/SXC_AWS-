# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sxc_aws_db?schema=public"

# NextAuth Secret for authentication sessions
NEXTAUTH_SECRET="sxc_aws_super_secure_secret_key_change_in_production"

# Public site deployment URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
